#!/usr/bin/env python3

import json
import os
import shutil
import sys
import tempfile

from datetime import datetime
from shared import *

sys.tracebacklimit = 0

config_schema = {
    "source": {
        "user": "",
        "host": "",
        "private_key": "",
        "known_hosts": ""
    },
    "params": {}
}

def main(path, config):
    validate_schema(config, config_schema)
    user = config["source"]["user"]
    host = config["source"]["host"]
    private_key = config["source"]["private_key"]
    params = config["params"]

    if not isinstance(params, dict):
        raise ValueError("Expected 'params' to be a dict")
    if not isinstance(user, str) or not user or not isinstance(host, str) or not host:
        raise ValueError("source.user and source.host must be non-empty strings")
    if not isinstance(private_key, str) or not private_key:
        raise ValueError("source.private_key must be a non-empty string")

    known_hosts = config["source"]["known_hosts"]
    if not isinstance(known_hosts, str) or not known_hosts.strip():
        raise ValueError("source.known_hosts must contain trusted SSH host keys")
    secret_dir = tempfile.mkdtemp(prefix="concourse-ssh-")
    os.chmod(secret_dir, 0o700)
    try:
        private_key_path = write_secret(secret_dir, "id_rsa", private_key)
        known_hosts_path = write_secret(secret_dir, "known_hosts", known_hosts)

        if "files" in params:
            scpTo(user, host, private_key_path, known_hosts_path, path, params["files"])

        if "commands" in params:
            sshRun(user, host, private_key_path, known_hosts_path, params["commands"])
    finally:
        shutil.rmtree(secret_dir)

path = sys.argv[1]
config = json.loads(sys.stdin.read())

main(path, config)

output = { "version": { "ref": "out - %s" % datetime.now().isoformat() } }
print(json.dumps(output))
exit(0)
